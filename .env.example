# ────────────────────────────────────────────────────────────────────
# Configuration EDR — copier en `.env` puis remplacer TOUTES les valeurs
# marquées CHANGE_ME. Générer un secret :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ────────────────────────────────────────────────────────────────────

APP_ENV=development
LOG_LEVEL=INFO

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=edr
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=edr
# API lancée sur l'hôte -> localhost ; API lancée par Compose -> db
DATABASE_URL=postgresql+asyncpg://edr:CHANGE_ME@localhost:5432/edr

# ── Sessions ────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME
SESSION_TTL_HOURS=12
# Passer à true dès que le dashboard est servi en HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Politique de mots de passe ──────────────────────────────────────
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ── CORS (dev uniquement : en prod le reverse proxy sert une origine unique) ──
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Authentification des agents installés sur les VM surveillées ─────
AGENT_TOKEN=CHANGE_ME

# ── Compte d'amorçage (créé au premier démarrage, rôle N3) ───────────
BOOTSTRAP_ADMIN_EMAIL=admin@soc.edr.local
# Laisser vide pour désactiver la création automatique
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ── Rétention / détection ───────────────────────────────────────────
METRICS_RETENTION_DAYS=30
AUTO_KILL_SCORE_THRESHOLD=80
BASELINE_MIN_VECTORS=10
RULES_ALERT_THRESHOLD=0.70

# ── Ports exposés ───────────────────────────────────────────────────
WEB_PORT=8080
# Agents Winlogbeat / PowerShell (lab VMnet1). La console reste sur WEB_PORT.
API_PORT=8000

# ── Frontend (build Vite) ───────────────────────────────────────────
# Vide = même origine que la page (mode production derrière nginx).
# En dev, Vite proxifie /api et /ws vers l'API : laisser vide également.
VITE_API_URL=
