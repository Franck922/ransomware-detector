# Cible du proxy de développement Vite (l'API FastAPI).
# En production, nginx sert le build et proxifie /api et /ws : rien à configurer.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Origine de l'API si le dashboard est servi depuis un domaine différent.
# Laisser vide dans la quasi-totalité des cas (même origine).
VITE_API_URL=
