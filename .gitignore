# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.egg-info/
dist/
build/

# Environnement virtuel
venv/
.venv/
env/

# Variables d'environnement (clés API, mots de passe)
.env
.env.*
# Le gabarit sans secret doit rester versionné
!.env.example

# ── Node / build frontend ───────────────────────────
node_modules/
dashboard/dist/
.vite/

# ── Modèles ML ──────────────────────────────────────
# random_forest_model.pkl et scaler.pkl restent versionnés : l'API les charge au
# démarrage, un clone sans eux tournerait sans détection ML. Ils pèsent 70 Ko.
# Seuls les artefacts lourds d'expérimentation sont exclus.
models/*.pt
models/*.pth
models/checkpoints/

# ── Artefacts de vérification ───────────────────────
dashboard/tests/screenshots/
reports/*.json

# ── Données brutes (trop lourdes pour Git) ──────────
data/raw/*
data/processed/*
# On garde les dossiers mais pas leur contenu
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# ── Logs locaux ─────────────────────────────────────
*.log
logs/

# ── OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── VS Code ─────────────────────────────────────────
.vscode/
*.code-workspace

# ── Jupyter (si utilisé pour expérimentation) ───────
.ipynb_checkpoints/
